[
  {
    "metricName": "final_response_exact_json",
    "threshold": 1,
    "criterion": {
      "finalResponse": {
        "text": {
          "matchStrategy": "exact"
        }
      }
    }
  },
  {
    "metricName": "tool_trajectory_avg_score",
    "threshold": 1,
    "criterion": {
      "toolTrajectory": {
        "orderSensitive": false,
        "defaultStrategy": {
          "name": {
            "matchStrategy": "exact"
          },
          "arguments": {
            "matchStrategy": "exact"
          },
          "result": {
            "matchStrategy": "exact"
          }
        }
      }
    }
  },
  {
    "metricName": "llm_rubric_json_grounding",
    "threshold": 0.9,
    "criterion": {
      "llmJudge": {
        "rubrics": [
          {
            "id": "format_json",
            "description": "The answer must be compact JSON.",
            "type": "FORMAT_COMPLIANCE",
            "content": {
              "text": "The final answer must be valid compact JSON with account, status, and source fields."
            }
          },
          {
            "id": "knowledge_recall",
            "description": "The answer must preserve account lookup facts.",
            "type": "FINAL_RESPONSE_QUALITY",
            "content": {
              "text": "The final answer must use the lookup or cache facts without changing account id or status."
            }
          }
        ]
      }
    }
  }
]
